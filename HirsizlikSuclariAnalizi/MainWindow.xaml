<Window x:Class="HirsizlikSuclariAnalizi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HirsizlikSuclariAnalizi"
        xmlns:vm="clr-namespace:HirsizlikSuclariAnalizi.ViewModels"
        mc:Ignorable="d"
        Title="Hırsızlık Suçları Analizi - TCK 141-142" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Başlık -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20" CornerRadius="5" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="HIRSIZLIK SUÇLARI ANALİZİ VE CEZA HESAPLAMA SİSTEMİ" 
                           FontSize="24" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="TCK Madde 141-142 | Yargıtay İçtihatları | PDF Rapor" 
                           FontSize="12" Foreground="#E0E0E0" 
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Ana İçerik -->
        <TabControl Grid.Row="1">
            
            <!-- Ceza Hesaplama Sekmesi -->
            <TabItem Header="Ceza Hesaplama" FontSize="14" Padding="20,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Sol Kolon: Parametreler -->
                        <StackPanel Grid.Column="0">
                            
                            <!-- Suç Türü -->
                            <GroupBox Header="Suç Türü" FontWeight="Bold">
                                <StackPanel>
                                    <RadioButton Content="Basit Hırsızlık (TCK 141)" 
                                                 IsChecked="{Binding SecilenHirsizlikTuru, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BasitHirsizlik}"
                                                 GroupName="HirsizlikTuru" Margin="5"/>
                                    <RadioButton Content="Nitelikli Hırsızlık (TCK 142)" 
                                                 IsChecked="{Binding SecilenHirsizlikTuru, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NitelikliHirsizlik}"
                                                 GroupName="HirsizlikTuru" Margin="5"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- Mal Değeri -->
                            <GroupBox Header="Çalınan Malın Değeri" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding MalDegeri, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="150" VerticalAlignment="Center"/>
                                    <TextBlock Text="TL" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- Nitelikli Haller (TCK 142/1) -->
                            <GroupBox Header="Nitelikli Haller - TCK 142/1 (1/2 Artırım)" FontWeight="Bold">
                                <StackPanel>
                                    <CheckBox Content="Gece vakti işlenmiş olması (TCK 142/1-a)" 
                                              IsChecked="{Binding GeceVakti}"/>
                                    <CheckBox Content="İki veya daha fazla kişi tarafından birlikte (TCK 142/1-b)" 
                                              IsChecked="{Binding BirlikteSuc}"/>
                                    <CheckBox Content="Savunamayacak durumda bulunan kişiye karşı (TCK 142/1-c)" 
                                              IsChecked="{Binding SavunmasizMagdur}"/>
                                    <CheckBox Content="Kamu binasında veya eklentilerinde (TCK 142/1-d)" 
                                              IsChecked="{Binding KamuBinasi}"/>
                                    <CheckBox Content="Felaket durumlarından yararlanarak (TCK 142/1-e)" 
                                              IsChecked="{Binding FelaketDurumu}"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- Nitelikli Haller (TCK 142/2) -->
                            <GroupBox Header="Nitelikli Haller - TCK 142/2 (1/3 Artırım)" FontWeight="Bold">
                                <StackPanel>
                                    <CheckBox Content="Dini hassasiyetle bağlantılı yerde (TCK 142/2-a)" 
                                              IsChecked="{Binding DiniYer}"/>
                                    <CheckBox Content="Eğitim, sağlık veya sosyal hizmet yerinde (TCK 142/2-b)" 
                                              IsChecked="{Binding HizmetYeri}"/>
                                    <CheckBox Content="Mesken, işyeri, iş makinesi veya eklentilerinde (TCK 142/2-c)" 
                                              IsChecked="{Binding MeskenIsyeri}"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- Özel Durumlar -->
                            <GroupBox Header="Özel Durumlar" FontWeight="Bold">
                                <StackPanel>
                                    <CheckBox Content="Etkin Pişmanlık (TCK 168)" 
                                              IsChecked="{Binding EtkinPismanlik}"/>
                                    <CheckBox Content="Uzlaştırma (CMK 253)" 
                                              IsChecked="{Binding Uzlastirma}"/>
                                    <CheckBox Content="Akraba Mağdur - Şikayete Tabi (TCK 167)" 
                                              IsChecked="{Binding AkrabaMagdur}"/>
                                    <CheckBox Content="Teşebbüs Aşamasında (TCK 35)" 
                                              IsChecked="{Binding Tesebbüs}"/>
                                    <CheckBox Content="HAGB Uygulanabilir (CMK 231)" 
                                              IsChecked="{Binding Hagb}"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- Butonlar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button Content="Ceza Hesapla" 
                                        Command="{Binding CezaHesaplaCommand}"
                                        Width="150" Height="40" FontSize="14" FontWeight="Bold"/>
                                <Button Content="Temizle" 
                                        Command="{Binding TemizleCommand}"
                                        Width="120" Height="40" FontSize="14"
                                        Background="#6C757D"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Sağ Kolon: Sonuçlar -->
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="Ceza Hesaplama Sonucu" FontWeight="Bold">
                                <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border BorderBrush="#0078D4" BorderThickness="2" 
                                                Background="#F0F8FF" Padding="15" Margin="5" CornerRadius="5"
                                                Visibility="{Binding HesaplananCeza, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel>
                                                
                                                <!-- Temel Ceza -->
                                                <TextBlock Text="TEMEL CEZA" FontWeight="Bold" FontSize="14" 
                                                           Foreground="#0078D4" Margin="0,0,0,10"/>
                                                <TextBlock>
                                                    <Run Text="Ceza Aralığı: " FontWeight="Bold"/>
                                                    <Run Text="{Binding HesaplananCeza.TemelCezaAltSinir}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding HesaplananCeza.TemelCezaUstSinir}"/>
                                                    <Run Text=" ay hapis"/>
                                                </TextBlock>
                                                
                                                <!-- Artırılmış Ceza -->
                                                <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                                <TextBlock Text="ARTIRIMIŞ CEZA" FontWeight="Bold" FontSize="14" 
                                                           Foreground="#0078D4" Margin="0,0,0,10"/>
                                                <TextBlock>
                                                    <Run Text="Ceza Aralığı: " FontWeight="Bold"/>
                                                    <Run Text="{Binding HesaplananCeza.ArtirimisCezaAltSinir}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding HesaplananCeza.ArtirimisCezaUstSinir}"/>
                                                    <Run Text=" ay hapis"/>
                                                </TextBlock>
                                                
                                                <!-- Nihai Ceza -->
                                                <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                                <TextBlock Text="NİHAİ CEZA" FontWeight="Bold" FontSize="16" 
                                                           Foreground="#D9534F" Margin="0,0,0,10"/>
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#D9534F">
                                                    <Run Text="{Binding HesaplananCeza.NihaiCezaAltSinir}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding HesaplananCeza.NihaiCezaUstSinir}"/>
                                                    <Run Text=" ay hapis"/>
                                                </TextBlock>
                                                
                                                <!-- Para Cezası -->
                                                <TextBlock Margin="0,10,0,0" 
                                                           Visibility="{Binding HesaplananCeza.ParaCezasi, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="Alternatif Para Cezası: " FontWeight="Bold"/>
                                                    <Run Text="{Binding HesaplananCeza.ParaCezasi, StringFormat=N2}"/>
                                                    <Run Text=" TL"/>
                                                </TextBlock>
                                                
                                                <!-- Açıklamalar -->
                                                <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                                <TextBlock Text="AÇIKLAMALAR" FontWeight="Bold" FontSize="14" 
                                                           Foreground="#0078D4" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding HesaplananCeza.Aciklamalar}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" 
                                                                       Margin="0,3" FontSize="11"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Yasal Dayanaklar -->
                                                <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                                <TextBlock Text="YASAL DAYANAKLAR" FontWeight="Bold" FontSize="14" 
                                                           Foreground="#0078D4" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding HesaplananCeza.YasalDayanaklar}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" 
                                                                       Margin="0,3" FontSize="11" FontWeight="SemiBold"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- PDF Oluştur Butonu -->
                                                <Button Content="PDF Rapor Oluştur" 
                                                        Command="{Binding RaporOlusturCommand}"
                                                        Width="180" Height="40" FontSize="14" FontWeight="Bold"
                                                        Background="#28A745" Margin="0,20,0,0"
                                                        HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Henüz Hesaplama Yapılmadı Mesajı -->
                                        <TextBlock Text="Ceza hesaplamak için sol taraftaki parametreleri doldurun ve 'Ceza Hesapla' butonuna tıklayın."
                                                   TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="20"
                                                   Visibility="{Binding HesaplananCeza, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <!-- Yargıtay Kararları Sekmesi -->
            <TabItem Header="Yargıtay Kararları" FontSize="14" Padding="20,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Arama -->
                    <GroupBox Header="Karar Arama" Grid.Row="0" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="400" VerticalAlignment="Center"/>
                            <Button Content="Ara" Command="{Binding YargitayAraCommand}" Width="100"/>
                            <Button Content="Tümünü Göster" Command="{Binding YargitayAraCommand}" Width="120"
                                    Background="#6C757D"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Kararlar Listesi ve Detay -->
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Liste -->
                        <GroupBox Header="Kararlar" Grid.Column="0" FontWeight="Bold">
                            <ListBox ItemsSource="{Binding YargitayKararlari}" 
                                     SelectedItem="{Binding SecilenKarar}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DaireNo}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock>
                                                    <Run Text="Esas: "/>
                                                    <Run Text="{Binding EsasNo}"/>
                                                    <Run Text=" / Karar: "/>
                                                    <Run Text="{Binding KararNo}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding KararTarihi, StringFormat=d}" 
                                                           FontSize="10" Foreground="Gray"/>
                                                <TextBlock Text="{Binding Ozet}" TextWrapping="Wrap" 
                                                           FontSize="11" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding TCKMaddesi}" 
                                                           FontSize="10" FontWeight="Bold" 
                                                           Foreground="#0078D4" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        
                        <!-- Detay -->
                        <GroupBox Header="Karar Detayı" Grid.Column="1" FontWeight="Bold" Margin="10,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Visibility="{Binding SecilenKarar, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SecilenKarar.DaireNo}" 
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock>
                                        <Run Text="Esas No: " FontWeight="Bold"/>
                                        <Run Text="{Binding SecilenKarar.EsasNo}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Karar No: " FontWeight="Bold"/>
                                        <Run Text="{Binding SecilenKarar.KararNo}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Tarih: " FontWeight="Bold"/>
                                        <Run Text="{Binding SecilenKarar.KararTarihi, StringFormat=d}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="TCK Maddesi: " FontWeight="Bold"/>
                                        <Run Text="{Binding SecilenKarar.TCKMaddesi}" Foreground="#0078D4"/>
                                    </TextBlock>
                                    
                                    <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                    
                                    <TextBlock Text="ÖZET" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SecilenKarar.Ozet}" TextWrapping="Wrap"/>
                                    
                                    <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                    
                                    <TextBlock Text="KARAR METNİ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SecilenKarar.KararMetni}" 
                                               TextWrapping="Wrap" TextAlignment="Justify"/>
                                    
                                    <Border Height="1" Background="#CCCCCC" Margin="0,15,0,15"/>
                                    
                                    <TextBlock Text="ANAHTAR KELİMELER" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SecilenKarar.AnahtarKelimeler}" 
                                               TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"/>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Hakkında Sekmesi -->
            <TabItem Header="Hakkında" FontSize="14" Padding="20,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="HIRSIZLIK SUÇLARI ANALİZİ VE CEZA HESAPLAMA SİSTEMİ" 
                                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Bu uygulama, Türk Ceza Kanunu'nun 141 ve 142. maddelerine göre hırsızlık suçlarının analizini ve ceza hesaplamasını yapmanızı sağlar."
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Özellikler:" FontWeight="Bold" FontSize="14" Margin="0,20,0,10"/>
                        <TextBlock Text="• Basit ve nitelikli hırsızlık türlerini destekler" Margin="20,3,0,3"/>
                        <TextBlock Text="• TCK 141 ve 142. maddelere göre ceza hesaplaması" Margin="20,3,0,3"/>
                        <TextBlock Text="• Nitelikli hallerin otomatik değerlendirilmesi" Margin="20,3,0,3"/>
                        <TextBlock Text="• Etkin pişmanlık, uzlaştırma gibi indirim sebeplerinin hesaplanması" Margin="20,3,0,3"/>
                        <TextBlock Text="• Yargıtay kararlarına erişim ve arama" Margin="20,3,0,3"/>
                        <TextBlock Text="• PDF rapor oluşturma" Margin="20,3,0,3"/>
                        
                        <TextBlock Text="Yasal Uyarı:" FontWeight="Bold" FontSize="14" Margin="0,20,0,10" Foreground="#D9534F"/>
                        <TextBlock Text="Bu uygulama yalnızca bilgilendirme ve eğitim amaçlıdır. Hesaplanan cezalar yaklaşık değerlerdir ve hukuki bağlayıcılığı yoktur. Kesin ceza tayini mahkemeler tarafından yapılır ve somut olayın tüm özellikleri dikkate alınır. Hukuki danışmanlık için mutlaka bir avukata başvurunuz."
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#D9534F" FontWeight="SemiBold"/>
                        
                        <TextBlock Text="TCK İlgili Maddeler:" FontWeight="Bold" FontSize="14" Margin="0,20,0,10"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="TCK Madde 141 - Hırsızlık:" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="(1) Zilyedinin rızası olmadan başkasına ait taşınır bir malı, kendisine veya başkasına bir yarar sağlamak maksadıyla bulunduğu yerden alan kimseye bir yıldan üç yıla kadar hapis cezası verilir."/>
                        </TextBlock>
                        
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="TCK Madde 142 - Nitelikli Haller:" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="(1) Hırsızlık suçunun;"/>
                            <LineBreak/>
                            <Run Text="a) Gece vakti,"/>
                            <LineBreak/>
                            <Run Text="b) İki veya daha fazla kişi tarafından birlikte,"/>
                            <LineBreak/>
                            <Run Text="c) Beden veya ruh bakımından kendisini savunamayacak durumda bulunan kişiye karşı,"/>
                            <LineBreak/>
                            <Run Text="ç) Bir kamu binasında veya eklentilerinde,"/>
                            <LineBreak/>
                            <Run Text="d) Felaket durumlarından yararlanarak,"/>
                            <LineBreak/>
                            <Run Text="İşlenmesi halinde, verilecek ceza üçte birden yarısına kadar artırılır."/>
                        </TextBlock>
                        
                        <TextBlock Text="Versiyon: 1.0.0" FontSize="12" Foreground="Gray" Margin="0,30,0,5"/>
                        <TextBlock Text="© 2024 - Hırsızlık Suçları Analizi Sistemi" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
