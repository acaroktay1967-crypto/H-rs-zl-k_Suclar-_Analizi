<Application x:Class="HirsizlikSuclariAnalizi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HirsizlikSuclariAnalizi"
             xmlns:converters="clr-namespace:HirsizlikSuclariAnalizi.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
    </Application.Resources>
</Application>
